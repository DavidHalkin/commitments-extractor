STORE_DRIVER=local
DEEPGRAM_API_KEY=
# Vercel AI Gateway key for local runs and `npm run eval`; deployments on Vercel authenticate with OIDC instead.
AI_GATEWAY_API_KEY=
# Any AI Gateway model id; default openai/gpt-5-mini (free AI Gateway tier), e.g. anthropic/claude-sonnet-5 with paid credits
EXTRACT_MODEL=openai/gpt-5-mini
# STORE_DRIVER=blob outside Vercel only: read-write token of the private Blob store (or run `vercel env pull`)
BLOB_READ_WRITE_TOKEN=
# production: Vercel Cron sends it as a bearer token to /api/cron/cleanup (any long random string)
CRON_SECRET=

#Personal access token for the Vercel REST API — lets the AI agent read and manage account/project settings
VERCEL_ACCESS_TOKEN=
