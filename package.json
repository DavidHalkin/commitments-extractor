{
  "name": "commitments-extractor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures": "tsx scripts/make-invalid-fixtures.ts",
    "synth": "tsx --env-file=.env.local scripts/synthesize.ts",
    "eval": "tsx --env-file=.env.local scripts/eval.mts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.105",
    "file-type": "^22.1.0",
    "music-metadata": "^11.15.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
